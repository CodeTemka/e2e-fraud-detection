# Copy this file to .env and provide your credentials. The .env file is git-ignored to keep secrets out of version control.
SUBSCRIPTION_ID = "your-azure-subscription-id"
RESOURCE_GROUP = "e2e-fraud-detection-rg"
WORKSPACE_NAME = "e2e-fraud-detection-ws"
LOCATION = "eastasia"

GITHUB_TOKEN = 'your-github-token'
GITHUB_OWNER = 'your-github-username-or-organization'
GITHUB_REPO = 'e2e-fraud-detection'

KAGGLE_USERNAME = 'your-kaggle-username'
KAGGLE_KEY = 'your-kaggle-api-key'
